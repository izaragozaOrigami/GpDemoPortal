<?xml version="1.0" encoding="utf-8"?>
<!--
  Static Next.js export served as a virtual application under /demoapps on
  Azure App Service (IIS).

  Purpose: the ROOT application (which occupies "/") has rules that redirect
  unauthenticated requests to /auth/login. Those rules are inherited by this
  subfolder and hijack /demoapps before our static files are served. This file
  resets that inherited configuration so /demoapps is served as a public,
  standalone static site.
-->
<configuration>
  <!-- Reset inherited Forms/auth so the parent app does not force a login here.
       Takes full effect when /demoapps is a virtual *application* (own app
       boundary). -->
  <system.web>
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>

  <system.webServer>
    <!-- Drop any URL Rewrite rules inherited from the root app (e.g. the rule
         that redirects to /auth/login). This is the most common cause of the
         redirect and works even for a plain subfolder. -->
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>

    <!-- trailingSlash export emits apps/checklist/index.html, etc. Make IIS
         serve index.html for directory requests. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Correct MIME types for assets IIS may not know by default. -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Serve the exported 404 page instead of the platform/parent one. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/demoapps/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
