<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (Windows) / Azure App Service Windows -> Next.js standalone vía
  HttpPlatformHandler. Coloca este web.config en la RAÍZ de la app (junto a
  server.js).

  Requisitos en el servidor:
    - Node.js instalado. IMPORTANTE: 'processPath' DEBE apuntar al node.exe real.
      En Azure App Service Windows el node está versionado, p.ej.
      C:\Program Files\nodejs\20.19.0\node.exe  (NO existe uno sin versión).
      Averigua la ruta exacta en Kudu (https://<sitio>.scm.azurewebsites.net ->
      "Debug console" -> CMD) ejecutando:  where node
      y pega esa ruta en processPath.
    - Next 16 requiere Node >= 20.9 (o 18.18). Si el App Service usa una versión
      menor, el proceso arranca y muere -> mismo error de CGI. Ajusta el setting
      WEBSITE_NODE_DEFAULT_VERSION a ~20 o superior.
    - Módulo HttpPlatformHandler (ya disponible en Azure App Service Windows).

  Diagnóstico: si algo falla, el motivo queda en .\logs\node.log (esta carpeta
  se incluye en el bundle). También visible en Kudu / Log stream.

  Variables de la app (Graph, userservice, JWT): definirlas en
  "Configuration -> Application settings" del App Service (recomendado), o
  descomentar abajo.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node.log"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  processPath="C:\Program Files\nodejs\node.exe"
                  arguments=".\server.js">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />

        <!-- Config de la app: mejor usar Application settings en Azure.
        <environmentVariable name="GRAPH_TENANT_ID" value="" />
        <environmentVariable name="GRAPH_CLIENT_ID" value="" />
        <environmentVariable name="GRAPH_CLIENT_SECRET" value="" />
        <environmentVariable name="GRAPH_MAILBOX" value="demo-gpfleet@kubus-tech.com.mx" />
        <environmentVariable name="USERSERVICE_URL" value="https://gpfleetdemousersservice.azurewebsites.net/api/" />
        <environmentVariable name="JWT_ISSUER" value="Origami.Identity" />
        <environmentVariable name="JWT_AUDIENCE" value="Origami.Identity" />
        <environmentVariable name="JWT_SIGNING_KEY" value="" />
        <environmentVariable name="DEMO_USER_ID" value="" />
        -->
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
